#!/bin/sh
# pre-push 质量门禁：无远端 CI 的替代方案（spec #1 / AGENTS.md）。
# 依次执行 format check、lint、unit + e2e test，任一步失败即非零退出，git 中止 push。
#
# 启用方式（仓库本地配置，一次性）：
#   git config core.hooksPath .githooks
#
# 约束：除 localhost 外不访问网络（e2e 用内存 stub server，全 hermetic）。
set -e

cd "$(git rev-parse --show-toplevel)"

echo "[pre-push] 1/3 cargo fmt --check"
cargo fmt --check

echo "[pre-push] 2/3 cargo clippy --workspace --all-targets -- -D warnings"
cargo clippy --workspace --all-targets -- -D warnings

echo "[pre-push] 3/3 cargo test --workspace"
cargo test --workspace

echo "[pre-push] 门禁全部通过"